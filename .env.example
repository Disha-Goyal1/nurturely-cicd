# Public client-side Supabase configuration. Use the Supabase publishable key,
# never a service_role key or database password.
# This Compose stack has no PostgreSQL or backend service, so no POSTGRES_PASSWORD is required.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
